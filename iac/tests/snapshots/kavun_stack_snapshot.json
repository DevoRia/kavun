        "DefinitionString": {
          "Fn::Join": [
            "",
            [
              "{\"StartAt\":\"GeneratePrompt\",\"States\":{\"GeneratePrompt\":{\"Next\":\"ParsePrompt\",\"Retry\":[{\"ErrorEquals\":[\"Lambda.ClientExecutionTimeoutException\",\"Lambda.ServiceException\",\"Lambda.AWSLambdaException\",\"Lambda.SdkClientException\"],\"IntervalSeconds\":2,\"MaxAttempts\":6,\"BackoffRate\":2}],\"Type\":\"Task\",\"ResultPath\":\"$.prompt_result\",\"Resource\":\"arn:",
              {
                "Ref": "AWS::Partition"
              },
              ":states:::lambda:invoke\",\"Parameters\":{\"FunctionName\":\"",
              {
                "Fn::GetAtt": [
                  "KavunPromptLambdaD850A442",
                  "Arn"
                ]
              },
              "\",\"Payload\":{\"word.$\":\"$.word\",\"language.$\":\"$.language\"}}},\"ParsePrompt\":{\"Type\":\"Pass\",\"Parameters\":{\"word.$\":\"$.word\",\"language.$\":\"$.language\",\"prompt.$\":\"$.prompt_result.Payload.body\"},\"Next\":\"CheckDuplicate\"},\"CheckDuplicate\":{\"Type\":\"Choice\",\"Choices\":[{\"Variable\":\"$.prompt\",\"StringMatches\":\"*already_exists*\",\"Next\":\"SkipImageGeneration\"}],\"Default\":\"GenerateImage\"},\"GenerateImage\":{\"End\":true,\"Retry\":[{\"ErrorEquals\":[\"Lambda.ClientExecutionTimeoutException\",\"Lambda.ServiceException\",\"Lambda.AWSLambdaException\",\"Lambda.SdkClientException\"],\"IntervalSeconds\":2,\"MaxAttempts\":6,\"BackoffRate\":2}],\"Type\":\"Task\",\"ResultPath\":\"$.image_result\",\"Resource\":\"arn:",
              {
                "Ref": "AWS::Partition"
              },
              ":states:::lambda:invoke\",\"Parameters\":{\"FunctionName\":\"",
              {
                "Fn::GetAtt": [
                  "KavunImageLambdaAA5FCFB6",
                  "Arn"
                ]
              },
              "\",\"Payload\":{\"word.$\":\"$.word\",\"prompt.$\":\"$.prompt\",\"language.$\":\"$.language\"}}},\"SkipImageGeneration\":{\"Type\":\"Pass\",\"Result\":{\"message\":\"Word already exists, skipping image generation\",\"word\":\"$.word\",\"status\":\"already_exists\"},\"End\":true}},\"TimeoutSeconds\":1800}"
            ]
          ]
        },
